import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

from sklearn.model_selection import train_test_split
from sklearn.tree import DecisionTreeClassifier, plot_tree
from sklearn import metrics

# 📁 Load dataset from CSV
df = pd.read_csv("titanic.csv")   # 👈 replace with your file

# 📊 Select required columns
df = df[['sex', 'age', 'fare', 'survived']]

# 🧹 Handle missing values
df['age'].fillna(df['age'].median(), inplace=True)

# 🔁 Encode categorical variable
df['sex'] = df['sex'].map({'male': 0, 'female': 1})

# 🎯 Features & Target
X = df[['sex', 'age', 'fare']]
y = df['survived']

# ✂️ Split dataset
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.3, random_state=42
)

# 🌳 Train ID3 (Entropy-based Decision Tree)
model = DecisionTreeClassifier(criterion='entropy', max_depth=4)
model.fit(X_train, y_train)

# 🔮 Prediction
y_pred = model.predict(X_test)

# 📌 Accuracy
print("Titanic Accuracy:", metrics.accuracy_score(y_test, y_pred))

# 🌳 Tree Visualization
plt.figure(figsize=(12, 8))
plot_tree(model, feature_names=X.columns,
          class_names=['Not Survived', 'Survived'],
          filled=True, max_depth=2)
plt.show()

# 🧪 New Prediction (IMPORTANT FIXED SHAPE)
new_sample = np.array([[1, 0, 30]])   # sex, age, fare
print("Prediction:",
      "Survived" if model.predict(new_sample)[0] == 1 else "Not Survived")

