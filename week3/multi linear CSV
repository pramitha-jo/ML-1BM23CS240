import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.linear_model import LinearRegression
from sklearn.model_selection import train_test_split
from sklearn.metrics import r2_score, mean_squared_error

# 📁 Step 1: Load dataset from CSV file
# Make sure CSV has columns: Hours_Studied, Attendance, Marks
df = pd.read_csv("your_dataset.csv")   # 👈 change file name here

print("Dataset Preview:")
print(df)

# 📊 Step 2: Independent & Dependent variables
X = df[['Hours_Studied', 'Attendance']]   # Independent variables
y = df['Marks']                          # Dependent variable

# ✂️ Step 3: Train-Test Split
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.25, random_state=42
)

# 🤖 Step 4: Model Training
model = LinearRegression()
model.fit(X_train, y_train)

# 🔮 Step 5: Prediction
y_pred = model.predict(X_test)

# 📌 Results
print("\nActual Values:", y_test.values)
print("Predicted Values:", y_pred)

# 📐 Model Parameters
print("\nIntercept (β0):", model.intercept_)
print("Coefficients (β1, β2):", model.coef_)

# 📊 Evaluation Metrics
r2 = r2_score(y_test, y_pred)
rmse = np.sqrt(mean_squared_error(y_test, y_pred))

print("\nR² Score:", r2)
print("RMSE:", rmse)
